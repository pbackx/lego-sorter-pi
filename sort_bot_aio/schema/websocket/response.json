{
    "$id": "response.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "WebSocketResponse",
    "type": "object",
    "properties": {
        "image": {
            "type": "string",
            "description": "Base64 encoded image"
        },
        "referenceImage": {
            "type": "string",
            "description": "Base64 encoded image of the empty belt that is used for detecting bricks"
        },
        "thresholdImage": {
            "type": "string",
            "description": "Base64 encoded image of the threshold values for detecting bricks"
        },
        "prediction": {
            "type": "string",
            "description": "Name of the predicted brick"
        }
    }
}